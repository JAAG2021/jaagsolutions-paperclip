# Copiar a deploy/.env y completar todos los valores antes de levantar servicios.
# NUNCA commitear deploy/.env con valores reales.
#
# Uso típico:
#   cd deploy && cp .env.production.example .env && nano .env
#   docker compose --env-file .env up -d

# ─── DOMINIO ──────────────────────────────────────────────────────────────────
# Dominio base sin protocolo ni barra final (ej. jaagsolutions.com).
DOMAIN=jaagsolutions.com

# ─── PAPERCLIP ────────────────────────────────────────────────────────────────
# Secreto para Better Auth (generar: openssl rand -hex 32)
BETTER_AUTH_SECRET=CAMBIA_ESTO_openssl_rand_hex_32

# URL pública HTTPS de Paperclip (callbacks, enlaces en UI). Debe coincidir con Caddy.
# Ejemplo: https://paperclip.jaagsolutions.com
PAPERCLIP_PUBLIC_URL=https://paperclip.jaagsolutions.com

# Directorio de datos persistentes de Paperclip en el HOST (montado en /paperclip en el contenedor)
PAPERCLIP_DATA_DIR=/opt/jaagsolutions/paperclip-data

# Modo: authenticated = login en UI; ver docs de despliegue para otros modos.
PAPERCLIP_DEPLOYMENT_MODE=authenticated

# Exposición dentro del VPS: private suele bastar cuando Caddy es el único frente público.
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# ─── POSTGRESQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=paperclip
POSTGRES_USER=paperclip
# Contraseña (generar: openssl rand -hex 24)
POSTGRES_PASSWORD=CAMBIA_ESTO_openssl_rand_hex_24

# ─── N8N ───────────────────────────────────────────────────────────────────────
N8N_DATA_DIR=/opt/jaagsolutions/n8n-data

# Basic auth de la UI n8n (obligatorio en producción mínima)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CAMBIA_ESTO_password_seguro

# Secreto compartido del webhook (obligatorio en producción: debe coincidir con cabecera o query; ver RUNBOOK).
# Generar: openssl rand -hex 16
FORMSPREE_WEBHOOK_SECRET=CAMBIA_ESTO_openssl_rand_hex_16

# Hashid del formulario en Formspree (campo "form" del JSON del webhook). Opcional pero recomendado.
# Ejemplo: el id que ves en el dashboard o en la URL de API; debe coincidir con payload.form.
FORMSPREE_FORM_HASHID=

# ─── IDs de Paperclip (rellenar tras seed + get-paperclip-ids.sh) ──────────────
PAPERCLIP_COMPANY_ID=
PAPERCLIP_A3_AGENT_ID=
PAPERCLIP_P2_PROJECT_ID=
PAPERCLIP_G2_GOAL_ID=

# API key de Paperclip (Settings → API Keys), para n8n → POST /api/companies/:id/issues
PAPERCLIP_API_KEY=

# ─── LET'S ENCRYPT (Caddy) ─────────────────────────────────────────────────────
LETSENCRYPT_EMAIL=admin@jaagsolutions.com
