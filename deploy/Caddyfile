# SSL automático (Let's Encrypt). Los registros DNS de paperclip.* y n8n.* deben apuntar al VPS antes del primer arranque.

{
	email {$LETSENCRYPT_EMAIL}
}

paperclip.{$DOMAIN} {
	reverse_proxy paperclip:3100
	encode gzip
	log {
		output stderr
	}
}

n8n.{$DOMAIN} {
	# Imágenes generadas por el Content Generator — públicas bajo /static-content/*
	# (necesario para Meta/LinkedIn que requieren URL accesible para descargar la imagen).
	# Se sirve bajo el subdominio n8n para evitar agregar DNS nuevo.
	handle_path /static-content/* {
		root * /srv/content
		file_server
		header Cache-Control "public, max-age=3600"
	}
	handle {
		reverse_proxy n8n:5678
	}
	encode gzip
	log {
		output stderr
	}
}

{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}
