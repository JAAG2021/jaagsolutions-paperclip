FROM n8nio/n8n:1.112.6

USER root

# corepack viene con Node.js — lo usamos para activar pnpm sin npm.
# Pinneamos pnpm v9 (rama mantenida) porque v10+ bloquea install scripts por defecto
# y sharp necesita ejecutar su script de install para descargar binarios libvips.
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Instalar sharp en directorio aislado con pnpm.
# Pinneamos sharp@0.32.x — sharp 0.33+ separó los binarios en sub-packages
# (@img/sharp-*), y los nested requires de sub-packages son bloqueados por la
# sandbox @n8n_io/riot del Code node (no están en NODE_FUNCTION_ALLOW_EXTERNAL).
# 0.32.x mantiene el binario directo en sharp/build/Release/sharp.node con
# require relativo, que NO pasa por la sandbox.
RUN mkdir -p /opt/n8n-modules && \
    cd /opt/n8n-modules && \
    echo '{"name":"n8n-modules","version":"1.0.0","private":true}' > package.json && \
    pnpm add --node-linker=hoisted sharp@0.32.6 && \
    pnpm store prune

# NODE_PATH permite que require('sharp') lo encuentre desde Code nodes
ENV NODE_PATH=/opt/n8n-modules/node_modules

# Scripts standalone que corren FUERA del sandbox n8n (via Execute Command node)
COPY n8n-scripts/ /opt/n8n-scripts/

USER node
WORKDIR /home/node
