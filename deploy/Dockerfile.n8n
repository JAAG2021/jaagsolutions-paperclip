FROM n8nio/n8n:1.112.6

USER root

# corepack viene con Node.js — lo usamos para activar pnpm sin npm.
# Pinneamos pnpm v9 (rama mantenida) porque v10+ bloquea install scripts por defecto
# y sharp necesita ejecutar su script de install para descargar binarios libvips.
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Instalar sharp en directorio aislado con pnpm
RUN mkdir -p /opt/n8n-modules && \
    cd /opt/n8n-modules && \
    echo '{"name":"n8n-modules","version":"1.0.0","private":true}' > package.json && \
    pnpm add --node-linker=hoisted sharp && \
    pnpm store prune

# NODE_PATH permite que require('sharp') lo encuentre desde Code nodes
ENV NODE_PATH=/opt/n8n-modules/node_modules

USER node
WORKDIR /home/node
