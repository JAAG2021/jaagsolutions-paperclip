        "query": "SELECT * FROM content_plan WHERE id = '{{ $('Parsear callback').first().json.post_id }}'",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "3WAwEY7SXDBTW16f",
          "name": "Postgres account"
        }
      }
    },
