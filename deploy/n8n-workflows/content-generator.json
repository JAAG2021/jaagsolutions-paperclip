{
  "name": "Content Generator — Cron → Stability AI → Vision → Telegram",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Cron 8 AM diario",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
