    {
      "id": "code-prep-telegram",
      "name": "Preparar binario Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3280,
        140
      ],
      "parameters": {
        "jsCode": "const postData = $('Validar OCR').first().json;\nconst fs = require('fs');\nconst filePath = postData.image_url;\nconst fileBuffer = fs.readFileSync(filePath);\nconst base64 = fileBuffer.toString('base64');\n\nreturn [{\n  json: postData,\n  binary: {\n    photo: {\n      data: base64,\n      mimeType: 'image/jpeg',\n      fileName: `${postData.id}.jpg`\n    }\n  }\n}];"
      }
    },
    {
      "id": "telegram-send",
      "name": "Telegram — enviar para aprobación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3500,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendPhoto",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $env.TELEGRAM_CHAT_ID }}"
            },
            {
              "name": "caption",
              "value": "={{ '📅 *' + new Date($json.scheduled_date).toLocaleDateString('es-CO', {day:'2-digit', month:'long', year:'numeric'}) + ' ' + ($json.scheduled_time || '') + '*\\n📱 ' + ($json.platform || '').toUpperCase() + ' — ' + ($json.pillar || '') + '\\n\\n' + ($json.copy_text || '') + '\\n\\n' + ($json.hashtags || '') }}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            },
            {
              "name": "reply_markup",
              "value": "={{ JSON.stringify({ inline_keyboard: [[{ text: '✅ Aprobar', callback_data: 'aprobar_' + $json.id }, { text: '❌ Rechazar', callback_data: 'rechazar_' + $json.id }]] }) }}"
            },
            {
              "name": "photo",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "photo"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "postgres-set-telegram-id",
      "name": "Guardar telegram_msg_id",
      "type": "n8n-nodes-base.postgres",
