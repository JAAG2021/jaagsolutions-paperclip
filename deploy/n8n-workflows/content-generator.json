    {
      "id": "postgres-set-review",
      "name": "status = review",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3060,
        140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_plan SET status = 'review' WHERE id = '{{ $json.id }}'",
        "options": {}
      },
      "credentials": {
        "postgres": {
