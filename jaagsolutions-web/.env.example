# Copia a `.env.development.local` o configura estos valores en el panel de Vercel (Production / Preview).

# ID del formulario Formspree (ruta `/f/{ID}`).
# Obtener en https://formspree.io/ — sin este ID el UI envía pero los leads no llegan al backend.
VITE_FORMSPREE_ID=

# Measurement ID de Google Analytics 4 (formato G-XXXXXXXXXX).
VITE_GA_ID=

# Dominio público HTTPS sin barra final (ej: https://www.jaagsolutions.com ).
# Si está definido y no usas VITE_OG_IMAGE_URL, el build inyectará og:image = {SITE}/og-share.png
# (usa el arte en `public/og-share.png`).
VITE_SITE_URL=

# Opcional: URL absoluta HTTPS de og:image para sobreescribir {SITE}/og-share.png (~1200x630).
VITE_OG_IMAGE_URL=

# Opcional: vídeo del hero (Make/n8n, etc.). Si está vacío se prueba `public/media/hero-automation.webm` y `.mp4`; si no hay archivo, Lottie (`VITE_HERO_LOTTIE_PATH` o por defecto `lottie/workflow-demo.json`).
VITE_HERO_VIDEO_URL=

# Opcional: ruta desde `public` al JSON Lottie (o URL HTTPS). Por defecto: lottie/workflow-demo.json
VITE_HERO_LOTTIE_PATH=
